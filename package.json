{
  "name": "www-marijana",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "alchemy dev --env-file .env.local",
    "next:dev": "next dev",
    "build": "next build",
    "deploy": "alchemy deploy",
    "deploy:from-local": "alchemy deploy --env-file .env.local",
    "destroy": "alchemy destroy",
    "destroy:from-local": "alchemy destroy --env-file .env.local",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit --pretty false",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply marijana-site-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply marijana-site-db --remote",
    "atlas": "pnpm atlas:stamps",
    "atlas:stamps": "tsx scripts/build-stamps-atlas.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "~2.1.10",
    "@radix-ui/react-hover-card": "~1.1.23",
    "@radix-ui/react-popover": "~1.1.23",
    "@radix-ui/react-slot": "~1.3.3",
    "@radix-ui/react-toggle": "~1.1.18",
    "@radix-ui/react-tooltip": "~1.2.16",
    "@react-three/drei": "~10.7.8",
    "@react-three/fiber": "~9.7.0",
    "@tanstack/react-query": "5.101.0",
    "@web-kits/audio": "~0.2.0",
    "@zumer/snapdom": "~2.24.18",
    "class-variance-authority": "~0.7.1",
    "clsx": "~2.1.1",
    "culori": "~4.0.2",
    "dayjs": "~1.11.23",
    "dialkit": "~2.0.2",
    "dompurify": "~3.4.15",
    "drizzle-orm": "~0.45.2",
    "framer-motion": "~13.2.0",
    "lenis": "~1.3.26",
    "motion": "~13.2.0",
    "linkedom": "~0.18.13",
    "lucide-react": "^1.45.0",
    "next": "16.3.4",
    "next-themes": "~0.4.6",
    "perfect-freehand": "~1.2.3",
    "radix-ui": "~1.6.7",
    "raw-loader": "~4.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-error-boundary": "~6.1.5",
    "react-focus-lock": "~2.13.7",
    "react-responsive-masonry": "~2.7.2",
    "sharp": "~0.35.4",
    "tailwind-merge": "~3.6.0",
    "three": "~0.186.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vaul": "~1.1.2",
    "zod": "~4.6.2",
    "zustand": "~5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260605.1",
    "@ianvs/prettier-plugin-sort-imports": "~4.7.1",
    "@opennextjs/cloudflare": "1.19.11",
    "@svgr/webpack": "~8.1.0",
    "@tailwindcss/postcss": "~4.3.3",
    "@types/culori": "~4.0.1",
    "@types/node": "25.9.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-responsive-masonry": "~2.7.0",
    "@types/three": "~0.185.4",
    "alchemy": "0.93.11",
    "autoprefixer": "~10.5.6",
    "drizzle-kit": "~0.31.10",
    "encoding": "~0.1.13",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "~10.1.8",
    "postcss": "~8.5.28",
    "postcss-nesting": "~14.0.1",
    "prettier": "~3.9.6",
    "prettier-plugin-tailwindcss": "~0.8.1",
    "tailwind-scrollbar": "~4.0.2",
    "tailwindcss": "~4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "~4.23.13",
    "tw-animate-css": "~1.4.0",
    "wrangler": "4.98.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver",
      "workerd"
    ]
  }
}
